# Copy to .env and fill in. .env is gitignored — never commit the real key.
GROQ_API_KEY=gsk_your_key_here

# Optional. Defaults to openai/gpt-oss-120b.
# Must be a chat model available on your Groq account — list them with:
#   python -c "import os;from dotenv import load_dotenv;from groq import Groq;load_dotenv();print([m.id for m in Groq(api_key=os.environ['GROQ_API_KEY']).models.list().data])"
GROQ_MODEL=openai/gpt-oss-120b
